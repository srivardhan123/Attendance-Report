# Copy to .env and fill in real values before running aio app run

# Adobe I/O Runtime namespace (set automatically by aio app use)
# AIO_RUNTIME_NAMESPACE=
# AIO_RUNTIME_AUTH=

LOG_LEVEL=info

# Adobe Commerce (ACCS) — admin dashboard URL of the sandbox tenant
COMMERCE_SANDBOX_ADMIN_URL=
# Dedicated Commerce S2S credential (scope commerce.accs). If left blank, the
# project's shared IMS S2S credential (include-ims-credentials) is used instead.
COMMERCE_CLIENT_ID=
COMMERCE_CLIENT_SECRET=
COMMERCE_ORG_ID=

# Photoshop + Firefly S2S credential (same client for both APIs)
PHOTOSHOP_CLIENT_ID=
PHOTOSHOP_CLIENT_SECRET=
PHOTOSHOP_ORG_ID=
